ALLOWED_HOSTS=*
APPLY_MIGRATIONS=1
AUDIT_LOG_ENV=local
CSRF_TRUSTED_ORIGINS=
DEBUG=1
# Keep password login enabled in local development. Set to True in deployed
# environments after configuring the Helsinki Login OIDC client.
HELUSERS_PASSWORD_LOGIN_DISABLED=False
SENTRY_DSN=https://abcdefg@your.sentry.here/999
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_IGNORE_PATHS=/health,/readiness
# Helsinki Login OIDC client settings (client secret must be supplied securely).
SOCIAL_AUTH_TUNNISTAMO_KEY=
SOCIAL_AUTH_TUNNISTAMO_OIDC_ENDPOINT=
SOCIAL_AUTH_TUNNISTAMO_SECRET=
